<style>
      #hero {
            position: relative;
            min-height: 100vh;
            background: var(--cream);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: all 0.3s ease;
      }

      #hero.hero-dark {
            background: var(--black);
      }
      #hero.hero-dark::before {
            background: transparent;
      }

      #hero.hero-dark::after {
            background: transparent;
      }

      /* Paper texture base */
      #hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                  radial-gradient(ellipse 70% 60% at 30% 40%, rgba(210, 185, 140, 0.45) 0%, transparent 65%),
                  radial-gradient(ellipse 50% 50% at 75% 70%, rgba(180, 155, 105, 0.25) 0%, transparent 60%), radial-gradient(ellipse 40% 30% at 60% 20%, rgba(240, 225, 190, 0.6) 0%, transparent 50%);
      }

      /* ── COLLAGE DECORATIVE ELEMENTS ── */
      .collage-wrap {
            position: absolute;
            inset: 0;
            pointer-events: none;
      }

      /* Perfume bottle */
      .deco-bottle {
            position: absolute;
            top: 8%;
            right: 8%;
            opacity: 0.12;
            transform: rotate(12deg);
            animation: floatA 7s ease-in-out infinite;
      }
      /* Shopping bag */
      .deco-bag {
            position: absolute;
            bottom: 15%;
            left: 6%;
            opacity: 0.1;
            transform: rotate(-8deg);
            animation: floatB 9s ease-in-out infinite 1s;
      }
      /* Clothing tag */
      .deco-tag {
            position: absolute;
            top: 20%;
            left: 12%;
            opacity: 0.08;
            transform: rotate(-15deg);
            animation: floatA 11s ease-in-out infinite 2s;
      }
      /* Coffee cup */
      .deco-cup {
            position: absolute;
            bottom: 20%;
            right: 14%;
            opacity: 0.1;
            transform: rotate(6deg);
            animation: floatB 8s ease-in-out infinite 0.5s;
      }
      /* Abstract circles */
      .deco-circle-1 {
            position: absolute;
            top: -80px;
            right: -80px;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            border: 1px solid rgba(92, 61, 30, 0.08);
            animation: slowSpin 40s linear infinite;
      }
      .deco-circle-2 {
            position: absolute;
            bottom: -120px;
            left: -120px;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            border: 1px solid rgba(92, 61, 30, 0.06);
            animation: slowSpin 55s linear infinite reverse;
      }
      .deco-circle-3 {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 700px;
            height: 700px;
            border-radius: 50%;
            border: 1px solid rgba(45, 138, 78, 0.06);
            animation: slowSpin 80s linear infinite;
      }

      /* Torn ink lines */
      .ink-line {
            position: relative;
            height: 3px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
            opacity: 0;
            left: 50%;
            transform: translateX(-50%);
            transition:
                  opacity 1.5s 0.5s,
                  width 1.5s 0.5s;
      }
      .ink-line-1 {
            margin-bottom: 40px;
            transform: translateX(-50%) rotate(-1deg);
      }
      .ink-line-2 {
            margin-top: 40px;
            transform: translateX(-50%) rotate(0.5deg);
      }

      #hero.hero-dark .ink-line {
            width: 150%;
            opacity: 1;
      }

      /* Ink stamp elements */
      .stamp {
            position: absolute;
            font-family: "Bebas Neue", sans-serif;
            letter-spacing: 5px;
            border: 2px solid;
            padding: 4px 12px;
            transform-origin: center;
            opacity: 0.2;
            color: var(--amber);
            border-color: var(--amber);
      }
      .stamp-1 {
            top: 15%;
            right: 22%;
            font-size: 11px;
            transform: rotate(15deg);
      }
      .stamp-2 {
            bottom: 28%;
            left: 18%;
            font-size: 11px;
            transform: rotate(-12deg);
      }

      /* ── HERO CONTENT ── */
      .hero-content {
            position: relative;
            z-index: 20;
            text-align: center;
            max-width: 900px;
            padding: 0 40px;
      }

      .hero-eyebrow {
            font-family: "JetBrains Mono", monospace;
            font-size: 10px;
            letter-spacing: 6px;
            color: var(--muted-warm);
            margin-bottom: 32px;
            opacity: 0;
            animation: riseIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
      }

      /* The main phrase — two-state reveal */
      .hero-phrase {
            position: relative;
            margin-bottom: 20px;
      }

      .hero-line-1 {
            font-family: "Playfair Display", serif;
            font-size: clamp(52px, 9vw, 130px);
            font-weight: 900;
            line-height: 0.95;
            color: var(--text-dark);
            display: block;
            opacity: 0;
            animation: riseIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
      }

      #hero.hero-dark .hero-line-1 {
            color: var(--text-light);
            opacity: 1;
            animation: none;
            transition: color 1s;
      }

      .hero-line-2-wrap {
            position: relative;
            display: inline-block;
            overflow: hidden;
            width: 100%;
            text-align: center;
      }

      .hero-line-2-a {
            font-family: "Playfair Display", serif;
            font-size: clamp(52px, 9vw, 130px);
            font-weight: 900;
            font-style: italic;
            color: var(--green);
            display: block;
            opacity: 0;
            transform: translateY(0);
            animation: riseIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.9s forwards;
            transition:
                  transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                  opacity 0.5s;
            line-height: 1;
            width: 100%;
      }
      .hero-line-2-b {
            font-family: "Playfair Display", serif;
            font-size: clamp(52px, 9vw, 130px);
            font-weight: 900;
            font-style: italic;
            color: var(--amber);
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            opacity: 0;
            transform: translateY(30px);
            transition:
                  transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                  opacity 0.5s;
            line-height: 1;
            width: 100%;
      }
      /* Glitch state — triggered by JS */
      .hero-line-2-wrap.glitched .hero-line-2-a {
            opacity: 0;
            transform: translateY(-30px);
            animation: none;
      }
      .hero-line-2-wrap.glitched .hero-line-2-b {
            opacity: 1;
            transform: translateY(0);
      }

      /* Glitch overlay effect */
      .glitch-fx {
            position: absolute;
            inset: 0;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.1s;
            background: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(255, 140, 0, 0.03) 3px, rgba(255, 140, 0, 0.03) 4px);
            mix-blend-mode: multiply;
      }
      .glitching .glitch-fx {
            opacity: 1;
      }

      .hero-sub {
            font-family: "Lora", serif;
            font-size: 16px;
            color: var(--muted-warm);
            line-height: 1.8;
            max-width: 560px;
            margin: 36px auto 0;
            font-weight: 400;
            opacity: 0;
            text-align: center;
            width: 100%;
            transform: translateY(30px);
            transition:
                  opacity 1s,
                  transform 2s;
      }
      .hero-sub em {
            font-style: italic;
            color: var(--warm-brown);
      }
      #hero.hero-dark .hero-sub {
            opacity: 1;
            transform: translateY(0);
      }

      /* Shopping cart tipping animation */
      #hero:not(.hero-dark) .cart-container {
            opacity: 0;
      }

      .cart-container {
            z-index: -100;
            opacity: 0.25;
            position: absolute;
            width: fit-content;
            padding: 10px;
            aspect-ratio: 1 / 1;
            background: #0005;
            border: none;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition:
                  opacity 1.2s 2s,
                  border-color 0.3s,
                  box-shadow 0.3s,
                  transform 0.2s;
            outline: none;
            top: 20px;
            right: 20px;
            rotate: -20deg;
      }

      /* Cart icon */
      .cart-icon {
            color: var(--amber);
            transition: color 0.3s;
            flex-shrink: 0;
      }

      /* ── THE BADGE ── */
      .badge {
            position: absolute;
            top: -10px;
            right: -10px;
            width: 14px;
            height: 14px;
            padding: 0 6px;
            border-radius: 999px;
            background: var(--amber);
            color: #000;
            font-family: "JetBrains Mono", monospace;
            font-size: 11px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
            box-shadow:
                  0 0 0 2px var(--bg),
                  0 0 12px rgba(0, 255, 136, 0.5);
            transform-origin: center;
            transition:
                  transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                  background 0.4s,
                  color 0.4s,
                  box-shadow 0.4s;
            will-change: transform;
            white-space: nowrap;
      }

      /* Badge bump — triggers on number change */
      .badge.bump {
            animation: badgeBump 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      @keyframes badgeBump {
            0% {
                  transform: scale(1);
            }
            40% {
                  transform: scale(1.2);
            }
            100% {
                  transform: scale(1);
            }
      }

      /* Overflow state — continuous spin */
      .badge.overflow {
            background: var(--amber);
            color: var(--text-dark);
            box-shadow:
                  0 0 0 2px var(--bg),
                  0 0 20px rgba(0, 255, 136, 0.7),
                  0 0 40px rgba(0, 255, 136, 0.3);
            font-size: 10px;
            padding: 0 7px;
      }

      /* Scroll cue */
      .hero-scroll {
            position: absolute;
            bottom: 36px;
            left: 50%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            opacity: 0;
            z-index: 20;
            transform: translateX(-50%) translateY(30px);
            transition:
                  opacity 1s,
                  transform 2s;
      }
      .hero-scroll.hero-scroll-visible {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
      }
      .hero-scroll span {
            font-family: "JetBrains Mono", monospace;
            font-size: 8px;
            letter-spacing: 5px;
            color: var(--muted-warm);
      }
      .scroll-line {
            width: 1px;
            height: 44px;
            background: linear-gradient(180deg, transparent, var(--amber));
            animation: scrollPulse 2.2s ease-in-out infinite;
      }
      @keyframes scrollPulse {
            0%,
            100% {
                  opacity: 0.3;
                  transform: scaleY(0.7);
            }
            50% {
                  opacity: 1;
                  transform: scaleY(1);
            }
      }

      /* Darkening vignette that grows as hero ages */
      .hero-vignette {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 80% 80% at 50% 50%, transparent 40%, rgba(8, 8, 8, 0) 100%);
            pointer-events: none;
            z-index: 5;
            opacity: 0;
            transition: opacity 2s;
      }

      /* ── SOME BASIC ANIMATIONS ── */
      @keyframes riseIn {
            from {
                  opacity: 0;
                  transform: translateY(28px);
            }
            to {
                  opacity: 1;
                  transform: translateY(0);
            }
      }
      @keyframes floatA {
            0%,
            100% {
                  transform: rotate(12deg) translateY(0);
            }
            50% {
                  transform: rotate(12deg) translateY(-16px);
            }
      }
      @keyframes floatB {
            0%,
            100% {
                  transform: rotate(-8deg) translateY(0);
            }
            50% {
                  transform: rotate(-8deg) translateY(-12px);
            }
      }
      @keyframes slowSpin {
            from {
                  transform: rotate(0deg);
            }
            to {
                  transform: rotate(360deg);
            }
      }
</style>

