      let currentProd = "shirt";
      function renderLifecycle(prod) {
            const data = products[prod];
            const track = document.getElementById("lifecycle-track");
            track.innerHTML = "";
            // Linear stages
            data.linear.forEach((s, i) => {
                  const row = document.createElement("div");
                  row.className = `stage-row ${s.type}`;
                  row.style.setProperty("--sd", i * 0.07 + "s");
                  row.innerHTML = `<div class="stage-icon">${s.icon}</div><div class="stage-content"><div class="stage-label">${s.stage}</div><div class="stage-title">${s.title}</div><div class="stage-desc">${s.desc}</div>${s.type === "crisis" ? `<div class="stage-tag">⚠ CRISIS POINT</div>` : ""}</div>`;
                  track.appendChild(row);
                  setTimeout(() => {
                        const so = new IntersectionObserver(
                              (es) => {
                                    es.forEach((e) => {
                                          if (e.isIntersecting) {
                                                setTimeout(() => e.target.classList.add("vis"), i * 70);
                                                so.unobserve(e.target);
                                          }
                                    });
                              },
                              { threshold: 0.15 },
                        );
                        so.observe(row);
                  }, 50);
            });
            // Divider
            const div = document.createElement("div");
            div.className = "circular-divider";
            div.innerHTML = '<div class="circ-line"></div><div class="circ-label">✦ BUT WHAT IF — THE CIRCULAR PATH</div><div class="circ-line right"></div>';
            track.appendChild(div);
            // Circular stages
            data.circular.forEach((s, i) => {
                  const row = document.createElement("div");
                  row.className = `stage-row ${s.type}`;
                  row.style.setProperty("--sd", (i + data.linear.length) * 0.07 + "s");
                  row.innerHTML = `<div class="stage-icon">${s.icon}</div><div class="stage-content"><div class="stage-label">${s.stage}</div><div class="stage-title">${s.title}</div><div class="stage-desc">${s.desc}</div><div class="stage-tag">✦ CIRCULAR PATH</div></div>`;
                  track.appendChild(row);
                  setTimeout(() => {
                        const so = new IntersectionObserver(
                              (es) => {
                                    es.forEach((e) => {
                                          if (e.isIntersecting) {
                                                setTimeout(() => e.target.classList.add("vis"), (i + 1) * 70);
                                                so.unobserve(e.target);
                                          }
                                    });
                              },
                              { threshold: 0.15 },
                        );
                        so.observe(row);
                  }, 50);
            });
      }
      document.querySelectorAll(".prod-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                  document.querySelectorAll(".prod-btn").forEach((b) => b.classList.remove("active"));
                  btn.classList.add("active");
                  currentProd = btn.dataset.prod;
                  renderLifecycle(currentProd);
            });
      });
      // Init when visible
      const lob = new IntersectionObserver(
            (entries) => {
                  entries.forEach((e) => {
                        if (e.isIntersecting) {
                              renderLifecycle("shirt");
                              lob.unobserve(e.target);
                        }
                  });
            },
            { threshold: 0.2 },
      );
      lob.observe(document.getElementById("lifecycle"));
</script>
