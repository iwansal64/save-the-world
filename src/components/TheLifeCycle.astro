                              icon: "🚛",
                              stage: "TRANSPORTED",
                              title: "Cold Chain Logistics",
                              desc: "Refrigerated trucks. Long supply chains. Food travels an average of <strong>1,500 miles</strong> before it reaches you.",
                        },
