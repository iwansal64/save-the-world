<style is:global>
      /* ═══════════════════════════════════════════════════════
      SECTION 5 — LIFECYCLE EXPLORER
      ═══════════════════════════════════════════════════════ */
      #lifecycle {
            position: relative;
            background: var(--black);
            overflow: hidden;
            padding: 120px 0 160px;
            border-top: 1px solid #111;
      }

      .lifecycle-header {
            text-align: center;
            padding: 0 24px 60px;
            position: relative;
            z-index: 10;
      }
      .lifecycle-eyebrow {
            font-family: "JetBrains Mono", monospace;
            font-size: 9px;
            letter-spacing: 6px;
            color: var(--green-light);
            margin-bottom: 20px;
      }
      .lifecycle-title {
            font-family: "Bebas Neue", sans-serif;
            font-size: clamp(48px, 8vw, 100px);
            letter-spacing: 4px;
            color: var(--text-light);
            line-height: 0.9;
      }
      .lifecycle-title span {
            color: var(--green-light);
      }
      .lifecycle-sub {
            margin-top: 20px;
            font-family: "Lora", serif;
            font-size: 15px;
            color: rgba(240, 237, 232, 0.35);
            font-style: italic;
      }

      /* Product picker */
      .product-picker {
            display: flex;
            gap: 2px;
            max-width: 700px;
            margin: 0 auto 64px;
            padding: 0 24px;
            position: relative;
            z-index: 10;
      }
      .prod-btn {
            flex: 1;
            background: #0c0c0c;
            border: 1px solid #1e1e1e;
            padding: 20px 16px;
            text-align: center;
            transition: all 0.3s;
      }
      .prod-btn:hover,
      .prod-btn.active {
            border-color: var(--green-light);
            background: #0d180d;
      }
      .prod-btn.active {
            box-shadow: 0 0 20px rgba(76, 175, 114, 0.1);
      }
      .prod-emoji {
            font-size: 28px;
            display: block;
            margin-bottom: 8px;
      }
      .prod-name {
            font-family: "JetBrains Mono", monospace;
            font-size: 9px;
            letter-spacing: 3px;
            color: rgba(240, 237, 232, 0.4);
            transition: color 0.3s;
      }
      .prod-btn.active .prod-name,
      .prod-btn:hover .prod-name {
            color: var(--green-light);
      }

      /* Lifecycle stages */
      .lifecycle-track {
            position: relative;
            z-index: 10;
            max-width: 900px;
            margin: 0 auto;
            padding: 0 24px;
      }
      /* The vertical connector line */
      .lifecycle-track::before {
            content: "";
            position: absolute;
            left: 51px; /* 24px padding + 27px (center of 56px icon) */
            top: 0;
            bottom: 0;
            width: 1px;
            background: linear-gradient(180deg, transparent 0%, rgba(255, 140, 0, 0.08) 10%, rgba(255, 140, 0, 0.25) 40%, rgba(45, 138, 78, 0.35) 70%, transparent 100%);
            animation: connPulse 3s ease-in-out infinite;
            z-index: 0;
      }

      .stage-row {
            display: flex;
            gap: 32px;
            align-items: flex-start;
            padding: 32px 0;
            border-bottom: 1px solid #111;
            opacity: 0;
            transform: translateX(-24px);
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--sd, 0s);
      }
      .stage-row.vis {
            opacity: 1;
            transform: translateX(0);
      }
      .stage-row.circular {
            border-color: rgba(45, 138, 78, 0.15);
      }
      .stage-icon {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
            border: 1px solid #1e1e1e;
            transition: all 0.4s;
      }
      .stage-row:hover .stage-icon {
            transform: scale(1.1);
      }
      .stage-row.linear .stage-icon {
            background: #0f0f0f;
            border-color: #1e1e1e;
      }
      .stage-row.crisis .stage-icon {
            background: rgba(255, 69, 0, 0.08);
            border-color: rgba(255, 69, 0, 0.2);
      }
      .stage-row.circular .stage-icon {
            background: rgba(45, 138, 78, 0.08);
            border-color: rgba(45, 138, 78, 0.25);
            box-shadow: 0 0 16px rgba(45, 138, 78, 0.08);
      }
      .stage-content {
            flex: 1;
      }
      .stage-label {
            font-family: "JetBrains Mono", monospace;
            font-size: 8px;
            letter-spacing: 4px;
            margin-bottom: 6px;
      }
      .stage-row.linear .stage-label {
            color: var(--muted-dark);
      }
      .stage-row.crisis .stage-label {
            color: var(--ember);
      }
      .stage-row.circular .stage-label {
            color: var(--green-light);
      }
      .stage-title {
            font-family: "Bebas Neue", sans-serif;
            font-size: 26px;
            letter-spacing: 2px;
            color: var(--text-light);
            line-height: 1;
            margin-bottom: 8px;
      }
      .stage-desc {
            font-family: "Lora", serif;
            font-size: 13px;
            color: rgba(240, 237, 232, 0.45);
            line-height: 1.7;
      }
      .stage-desc strong {
            color: rgba(240, 237, 232, 0.75);
      }
      .stage-tag {
            display: inline-block;
            margin-top: 10px;
            font-family: "JetBrains Mono", monospace;
            font-size: 8px;
            letter-spacing: 3px;
            padding: 4px 10px;
      }
      .stage-row.crisis .stage-tag {
            color: var(--ember);
            border: 1px solid rgba(255, 69, 0, 0.2);
            background: rgba(255, 69, 0, 0.04);
      }
      .stage-row.circular .stage-tag {
            color: var(--green-light);
            border: 1px solid rgba(45, 138, 78, 0.2);
            background: rgba(45, 138, 78, 0.04);
      }

      /* circular divider */
      .circular-divider {
            position: relative;
            z-index: 10;
            max-width: 900px;
            margin: 0 auto;
            padding: 48px 24px 0;
            display: flex;
            align-items: center;
            gap: 20px;
      }
      .circ-line {
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(45, 138, 78, 0.4));
      }
      .circ-line.right {
            background: linear-gradient(90deg, rgba(45, 138, 78, 0.4), transparent);
      }
      .circ-label {
            font-family: "JetBrains Mono", monospace;
            font-size: 9px;
            letter-spacing: 4px;
            color: var(--green-light);
            white-space: nowrap;
      }
</style>

<!-- ════════════════════════════════
