                              desc: "What can't be eaten returns to the soil. <strong>Compost closes the nutrient loop</strong> — no methane, just soil enrichment.",
                        },
                  ],
            },
            phone: {
                  linear: [
                        {
                              type: "linear",
                              icon: "⛏️",
                              stage: "MINED",
                              title: "Rare Earth Minerals",
                              desc: "Cobalt, lithium, coltan. <strong>Mined in conditions that would shock you.</strong> Your phone contains 62 of the 83 stable elements on the periodic table.",
                        },
                        {
                              type: "linear",
                              icon: "🏭",
