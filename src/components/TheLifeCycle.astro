                  ],
                  circular: [
                        {
                              type: "circular",
                              icon: "🥗",
                              stage: "EAT IT",
                              title: "Use What You Buy",
                              desc: "Meal planning. Shopping lists. <strong>Buying only what you'll actually use.</strong> Revolutionary.",
                        },
                        {
                              type: "circular",
                              icon: "🍱",
                              stage: "LEFTOVERS",
                              title: "Yesterday's Dinner",
                              desc: "The best meal is the one you already paid for. <strong>Leftovers aren't sad — waste is sad.</strong>",
