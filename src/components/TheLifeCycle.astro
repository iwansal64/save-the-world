                              type: "crisis",
                              icon: "🗑️",
                              stage: "THROWN AWAY",
                              title: "Landfill",
                              desc: "<strong>33% of all food produced globally is wasted</strong> — while 820 million people go hungry. Every. Single. Day.",
                        },
                        {
                              type: "crisis",
                              icon: "💨",
                              stage: "METHANE",
                              title: "Greenhouse Gas",
                              desc: "Rotting food in landfill produces methane — <strong>a greenhouse gas 80x more potent than CO₂</strong> over 20 years.",
