<style is:global>
      /* ═══════════════════════════════════════════════════════
      SECTION 4 — THE QUIZ
      ═══════════════════════════════════════════════════════ */
      #quiz {
            position: relative;
            background: var(--black);
            overflow: hidden;
            padding: 120px 0 160px;
      }

      .quiz-header {
            text-align: center;
            padding: 0 24px 80px;
            position: relative;
            z-index: 10;
      }
      .quiz-title {
            font-family: "Bebas Neue", sans-serif;
            font-size: clamp(52px, 9vw, 110px);
            letter-spacing: 4px;
            color: var(--text-light);
            line-height: 0.9;
      }
      .quiz-title span {
            color: var(--amber);
      }
      .quiz-sub {
            margin-top: 20px;
            font-family: "Lora", serif;
            font-size: 15px;
            color: rgba(240, 237, 232, 0.35);
            font-style: italic;
            max-width: 500px;
            margin: 20px auto 0;
      }

      /* Quiz progress bar */
      .quiz-progress-wrap {
            max-width: 700px;
            margin: 0 auto 48px;
            padding: 0 24px;
            position: relative;
            z-index: 10;
      }
      .quiz-progress-track {
            height: 2px;
            background: white;
            border-radius: 2px;
      }
      .quiz-progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--green), var(--amber));
            border-radius: 2px;
            transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 0 8px rgba(255, 140, 0, 0.5);
            width: 0%;
      }
      .quiz-q-counter {
            display: flex;
            justify-content: space-between;
            font-family: "JetBrains Mono", monospace;
            font-size: 9px;
            letter-spacing: 3px;
            color: var(--muted-dark);
            margin-bottom: 12px;
      }

      /* Question */
      .quiz-question-wrap {
            max-width: 700px;
            margin: 0 auto;
            padding: 0 24px;
            position: relative;
            z-index: 10;
      }
      .quiz-q-text {
            font-family: "Playfair Display", serif;
            font-size: clamp(22px, 3vw, 38px);
            font-style: italic;
            color: var(--text-light);
            line-height: 1.3;
            margin-bottom: 48px;
            min-height: 80px;
            opacity: 0;
            transform: translateY(16px);
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .quiz-q-text.show {
            opacity: 1;
            transform: translateY(0);
      }

      .quiz-options {
            display: grid;
            gap: 12px;
      }
      .quiz-opt {
            background: transparent;
            border: 1px solid #1e1e1e;
            padding: 22px 28px;
            text-align: left;
            position: relative;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            align-items: flex-start;
            gap: 16px;
      }
      .quiz-opt::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(255, 140, 0, 0.04);
            opacity: 0;
            transition: opacity 0.3s;
      }
      .quiz-opt:hover::before {
            opacity: 1;
      }
      .quiz-opt:hover {
            border-color: rgba(255, 140, 0, 0.4);
            transform: translateX(6px);
      }
      .quiz-opt:active {
            transform: scale(0.98);
      }
      .opt-letter {
            font-family: "Bebas Neue", sans-serif;
            font-size: 20px;
            color: var(--amber);
            letter-spacing: 2px;
            flex-shrink: 0;
            line-height: 1;
            margin-top: 2px;
            opacity: 0.5;
            transition: opacity 0.3s;
      }
      .quiz-opt:hover .opt-letter {
            opacity: 1;
      }
      .opt-text {
            font-family: "Lora", serif;
            font-size: 15px;
            color: rgba(240, 237, 232, 0.6);
            line-height: 1.6;
            transition: color 0.3s;
      }
      .quiz-opt:hover .opt-text {
            color: rgba(240, 237, 232, 0.9);
      }

      /* Result card */
      #quiz-result {
            display: none;
            position: relative;
            z-index: 10;
            max-width: 700px;
            margin: 0 auto;
            padding: 0 24px;
            opacity: 0;
            transition: opacity 0.8s;
      }
      #quiz-result.show {
            opacity: 1;
      }
      .result-card {
            background: #0c0c0c;
            border: 1px solid #1e1e1e;
            padding: 60px 52px;
            position: relative;
            overflow: hidden;
      }
      .result-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--amber), var(--ember));
            box-shadow: 0 0 20px rgba(255, 140, 0, 0.4);
      }
      .result-archetype-label {
            font-family: "JetBrains Mono", monospace;
            font-size: 9px;
            letter-spacing: 5px;
            color: var(--amber);
            margin-bottom: 16px;
      }
      .result-archetype-name {
            font-family: "Bebas Neue", sans-serif;
            font-size: clamp(48px, 7vw, 80px);
            color: var(--text-light);
            letter-spacing: 3px;
            line-height: 1;
            margin-bottom: 28px;
      }
      .result-archetype-desc {
            font-family: "Lora", serif;
            font-size: 16px;
            line-height: 1.8;
            color: rgba(240, 237, 232, 0.6);
            margin-bottom: 32px;
      }
      .result-archetype-desc em {
            color: var(--amber);
            font-style: normal;
            font-weight: 600;
      }
      .result-change {
            font-family: "JetBrains Mono", monospace;
            font-size: 11px;
            letter-spacing: 2px;
            color: var(--green-light);
            padding: 16px 20px;
            border: 1px solid rgba(45, 138, 78, 0.2);
            background: rgba(45, 138, 78, 0.05);
            line-height: 1.6;
      }
      .result-btns {
            display: flex;
            gap: 12px;
            margin-top: 32px;
            flex-wrap: wrap;
      }
      .result-btn {
            font-family: "JetBrains Mono", monospace;
            font-size: 10px;
            letter-spacing: 3px;
            padding: 14px 28px;
            transition: all 0.3s;
      }
      .result-btn-retry {
            background: transparent;
            border: 1px solid #2a2a2a;
            color: rgba(240, 237, 232, 0.5);
      }
      .result-btn-retry:hover {
            border-color: var(--amber);
            color: var(--amber);
      }
      .result-btn-next {
            background: var(--amber);
            border: none;
            color: #000;
            font-weight: 700;
      }
      .result-btn-next:hover {
            background: var(--ember);
            box-shadow: 0 0 20px rgba(255, 140, 0, 0.3);
      }
</style>

<!-- ════════════════════════════════
     S4 — THE QUIZ
════════════════════════════════ -->
<section id="quiz">
      <div class="quiz-header">
            <div class="badge reveal">// QUICK QUIZ</div>
            <h2 class="quiz-title reveal">WHO ARE<br /><span>YOU, REALLY?</span></h2>
            <p class="quiz-sub reveal">6 questions. No right answers. Just mirrors.</p>
      </div>
      <div class="quiz-progress-wrap reveal">
            <div class="quiz-q-counter"><span id="quiz-counter">QUESTION 1 OF 6</span><span id="q-score-label">YOUR ARCHETYPE FORMS</span></div>
            <div class="quiz-progress-track"><div class="quiz-progress-fill" id="quiz-progress"></div></div>
      </div>
      <div class="quiz-question-wrap">
            <div class="quiz-q-text show" id="quiz-q-text">Your favourite jacket has a hole. You...</div>
            <div class="quiz-options" id="quiz-options">
                  <!-- filled by JS -->
            </div>
            <div id="quiz-result">
                  <div class="result-card">
                        <div class="result-archetype-label">YOUR CONSUMER ARCHETYPE</div>
                        <div class="result-archetype-name" id="result-name">—</div>
                        <div class="result-archetype-desc" id="result-desc">—</div>
                        <div class="result-change" id="result-change">—</div>
                        <div class="result-btns">
                              <button class="result-btn result-btn-retry" id="btn-retry">↺ TRY AGAIN</button>
                              <button class="result-btn result-btn-next" onclick="document.getElementById('lifecycle').scrollIntoView({behavior:'smooth'})">CONTINUE →</button>
                        </div>
                  </div>
            </div>
      </div>
</section>

<script src="../scripts/quiz/quiz-mechanism.ts"></script>
