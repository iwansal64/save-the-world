<script>
      // Intersection observer — shared for .principle and .sdg12-shift
      const obs = new IntersectionObserver(
            (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("vis"); obs.unobserve(e.target); } }),
            { threshold: 0.15 }
      );
      document.querySelectorAll(".principle, .sdg12-shift").forEach((el) => obs.observe(el));
</script>