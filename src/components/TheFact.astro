---
import GapperBottom from "./GapperBottom.astro";
import GapperTop from "./GapperTop.astro";
---

<GapperTop />

<section id="fact" class="w-screen min-h-screen flex flex-col justify-center items-center">
      <div class="mb-80 mt-20 w-full flex flex-col items-center">
            <p class="text-(--black)/50 text-center text-md px-4 py-2 rounded-full font-bold bg-white/10">Raw Unfiltered Truth</p>
            <div class="w-4/5 h-0.5 bg-linear-to-r from-(--black)/10 via-(--black)/50 to-(--black)/10"></div>
      </div>
      <div class="flex flex-col gap-4 relative p-14 items-center">
            <p class="observe observe-once text-7xl w-max text-left -translate-x-full self-start duration-1000 relative -left-15 opacity-0 [&.active]:left-0 [&.active]:opacity-100">「</p>
            <h1 class="observe observe-once text-4xl md:text-7xl text-center font-bold duration-1000 opacity-0 scale-80 [&.active]:opacity-100 [&.active]:scale-100">
                  We're <span class="border border-(--green) bg-(--black) underline text-(--green) px-4">dooming</span> our own <span class="italic">people</span>
            </h1>
            <p class="observe observe-once text-7xl w-max text-right translate-x-fullz self-end duration-1000 relative -right-15 opacity-0 [&.active]:right-0 [&.active]:opacity-100">」</p>
      </div>
      <div class="observe observe-once duration-1500 mb-120 w-4/5 text-center translate-y-full opacity-0 [&.active]:opacity-100 [&.active]:translate-y-0">
            <p>
                  The wealthiest 10% of humanity drives nearly half of all consumption-based emissions. Our economy is engineered to keep us buying — planned obsolescence, disposable fashion,
                  single-use everything. We do not have a recycling problem. We have a consumption problem — and the system is designed to hide it.
            </p>
      </div>
</section>

<GapperBottom />
