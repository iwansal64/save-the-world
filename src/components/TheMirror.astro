---
const mirrorItems = ["The Impulse Buyer", "The Trend Chaser", "The Guilt Purchaser", "The Retail Therapist", "The Hoarder", "The Minimalist Wannabe", "The FOMO Shopper"];
const length = mirrorItems.length;
---

<section id="mirror" class="grain-dark">
      <!-- Floating bg text -->
      <div class="mirror-float mf-1">DESIRE</div>
      <div class="mirror-float mf-2">CONSUME</div>
      <div class="mirror-float mf-3">REPEAT</div>

      <!-- Intro -->
      <div class="mirror-intro">
            <div class="badge">// THE MIRROR</div>

            <!-- Mirror SVG with rotating archetype -->
            <div id="mirror-wrapper">
                  <div id="mirror-container">
                        {mirrorItems.map((value, index) => {
                              return <div class="mirror-svg-wrap" style={"overflow: hidden; position: absolute; transform-origin: center; transform: rotateY(" + ((index + 1) / length) * 360 + "deg) translateZ(400px) translateY(-35%); backface-visibility: hidden; animation-delay: " + (-index * 3 - 2.5) + "s;"} id="mirror-svg-wrap">
                                    <div class="reflection w-3/5 aspect-4/5 rounded-full fixed top-1/2 -translate-1/2 bg-(--amber) opacity-20" style={"animation-delay: " + (-index * 3 - 1) + "s;"}></div>
                                    <svg width="280" height="360" style="transform-box: fill-box;" viewBox="0 0 280 360" fill="none" xmlns="http://www.w3.org/2000/svg">
                                          <!-- Frame outer -->
                                          <rect x="4" y="4" width="272" height="352" rx="24" fill="none" stroke="#2a1f0f" stroke-width="8"></rect>
                                          <!-- Frame inner decoration -->
                                          <rect x="14" y="14" width="252" height="332" rx="18" fill="none" stroke="#1e1608" stroke-width="3"></rect>
                                          <!-- Mirror surface -->
                                          <rect x="22" y="22" width="236" height="316" rx="14" fill="url(#mirrorGrad)"></rect>
                                          <!-- Reflection shimmer -->
                                          <path d="M40 40 Q80 30 120 50 Q160 70 200 45 Q220 35 240 50" stroke="rgba(255,200,100,0.06)" stroke-width="1.5" fill="none"></path>
                                          <path d="M40 70 Q90 58 140 72 Q190 86 240 68" stroke="rgba(255,200,100,0.04)" stroke-width="1" fill="none"></path>
                                          <!-- Crack lines -->
                                          <path d="M140 22 L148 80 L132 110 L155 160" stroke="rgba(255,140,0,0.1)" stroke-width="0.8" fill="none"></path>
                                          <path d="M148 80 L168 95 L162 115" stroke="rgba(255,140,0,0.07)" stroke-width="0.5" fill="none"></path>
                                          <!-- Frame ornament top -->
                                          <circle cx="140" cy="4" r="12" fill="#1e1608" stroke="#2a1f0f" stroke-width="2"></circle>
                                          <circle cx="140" cy="4" r="5" fill="#FF8C00" opacity="0.4"></circle>
                                          <!-- Frame ornament corners -->
                                          <circle cx="16" cy="16" r="8" fill="#1a1208"></circle>
                                          <circle cx="264" cy="16" r="8" fill="#1a1208"></circle>
                                          <circle cx="16" cy="344" r="8" fill="#1a1208"></circle>
                                          <circle cx="264" cy="344" r="8" fill="#1a1208"></circle>
                                    </svg>

                                    <!-- Archetype text overlay -->
                                    <div class="mirror-archetype-wrap" id="archetype-wrap">
                                          <div class="archetype-text">{value}</div>
                                    </div>
                              </div>;
                        })}
                  </div>
                  <div class="w-full h-40 rounded-full bg-radial from-0% to-50% from-(--amber)/20 to-(--amber)/0 animate-[pulse_4s_infinite] "></div>
            </div>
      </div>

      <!-- Quote -->
      <div class="mirror-quote" id="mirror-quote">
            <blockquote>We are not rational consumers who occasionally make emotional decisions. We are emotional beings who occasionally make rational ones.</blockquote>
            <cite>— CONSUMER BEHAVIOURAL PSYCHOLOGY, 2019</cite>
      </div>

      <!-- Recognition strip -->
      <div class="mirror-reflection" style="margin-top: 80px; padding: 0 0 0;">
            <div class="reflection-label" id="refl-label">// WHICH ONE SOUNDS LIKE YOU</div>
            <div class="recognition-strip">
                  <div class="recognition-track" id="recog-track">
                        <div class="recog-pill"><span class="dot"></span>"I'll wear it at least once before deciding."</div>
                        <div class="recog-pill"><span class="dot"></span>"It was on sale, so technically I saved money."</div>
                        <div class="recog-pill"><span class="dot"></span>"I needed to cheer myself up."</div>
                        <div class="recog-pill"><span class="dot"></span>"I added it to cart just to see the total."</div>
                        <div class="recog-pill"><span class="dot"></span>"Only 2 left — I had to."</div>
                        <div class="recog-pill"><span class="dot"></span>"I'll return it if I don't use it."</div>
                        <div class="recog-pill"><span class="dot"></span>"It's an investment piece."</div>
                        <div class="recog-pill"><span class="dot"></span>"I was just browsing... for three hours."</div>
                        <div class="recog-pill"><span class="dot"></span>"It sparks joy. Probably."</div>
                        <div class="recog-pill"><span class="dot"></span>"Free shipping if I spend $20 more."</div>
                        <div class="recog-pill"><span class="dot"></span>"The algorithm knew what I needed."</div>
                        <div class="recog-pill"><span class="dot"></span>"It's for a version of me that exercises."</div>
                        <!-- Duplicate -->
                        <div class="recog-pill"><span class="dot"></span>"I'll wear it at least once before deciding."</div>
                        <div class="recog-pill"><span class="dot"></span>"It was on sale, so technically I saved money."</div>
                        <div class="recog-pill"><span class="dot"></span>"I needed to cheer myself up."</div>
                        <div class="recog-pill"><span class="dot"></span>"I added it to cart just to see the total."</div>
                        <div class="recog-pill"><span class="dot"></span>"Only 2 left — I had to."</div>
                        <div class="recog-pill"><span class="dot"></span>"I'll return it if I don't use it."</div>
                        <div class="recog-pill"><span class="dot"></span>"It's an investment piece."</div>
                        <div class="recog-pill"><span class="dot"></span>"I was just browsing... for three hours."</div>
                        <div class="recog-pill"><span class="dot"></span>"It sparks joy. Probably."</div>
                        <div class="recog-pill"><span class="dot"></span>"Free shipping if I spend $20 more."</div>
                        <div class="recog-pill"><span class="dot"></span>"The algorithm knew what I needed."</div>
                        <div class="recog-pill"><span class="dot"></span>"It's for a version of me that exercises."</div>
                  </div>
            </div>
      </div>


      <!-- Outro -->
      <div class="mirror-outro" id="mirror-outro">
            <p>
                  The system isn't broken.<br /><strong>It's working exactly as designed.</strong><br />The question is — designed for whom?
            </p>
            <div class="next-hint">SCROLL TO SEE THE REAL COST</div>
      </div>
</section>

<style>
      #mirror {
            position: relative;
            background: var(--black);
            overflow: hidden;
            padding-bottom: 140px;
      }

      /* Ambient glow pools */
      #mirror::before {
            content: "";
            position: absolute;
            top: 20%;
            left: 50%;
            transform: translateX(-50%);
            width: 600px;
            height: 400px;
            background: radial-gradient(ellipse, rgba(255, 140, 0, 0.04) 0%, transparent 70%);
            pointer-events: none;
      }
      #mirror::after {
            content: "";
            position: absolute;
            bottom: 10%;
            right: 10%;
            width: 400px;
            height: 300px;
            background: radial-gradient(ellipse, rgba(45, 138, 78, 0.06) 0%, transparent 70%);
            pointer-events: none;
      }

      /* Mirror intro area */
      .mirror-intro {
            position: relative;
            z-index: 20;
            text-align: center;
            padding: 120px 24px 80px;
      }

      .mirror-label {
            font-family: "JetBrains Mono", monospace;
            font-size: 9px;
            letter-spacing: 6px;
            color: var(--amber);
            margin-bottom: 60px;
      }

      /* Rotating archetype text inside mirror */
      .mirror-archetype-wrap {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -52%);
            width: 180px;
            text-align: center;
      }
      .archetype-text {
            font-family: "Playfair Display", serif;
            font-size: 16px;
            font-style: italic;
            color: var(--amber);
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            white-space: nowrap;
            text-align: center;
      }


      .mirror-quote {
            position: relative;
            z-index: 20;
            text-align: center;
            padding: 100px 24px 80px;
            max-width: 860px;
            margin: 0 auto;
      }
      .mirror-quote blockquote {
            font-family: "Playfair Display", serif;
            font-size: clamp(22px, 3.5vw, 42px);
            font-style: italic;
            font-weight: 700;
            color: var(--text-light);
            line-height: 1.4;
            position: relative;
      }
      .mirror-quote blockquote::after {
            content: "\201D";
            font-size: 120px;
            color: var(--amber);
            opacity: 0.5;
            position: absolute;
            bottom: -40px; right: -20px;
            font-family: "Playfair Display", serif;
            line-height: 1;
      }
      .mirror-quote blockquote::before {
            content: "\201C";
            font-size: 120px;
            color: var(--amber);
            opacity: 0.5;
            position: absolute;
            top: -40px; left: -20px;
            font-family: "Playfair Display", serif;
            line-height: 1;
      }
      .mirror-quote cite {
            display: block;
            margin-top: 24px;
            font-family: "JetBrains Mono", monospace;
            font-size: 10px;
            letter-spacing: 4px;
            color: var(--muted-dark);
            font-style: normal;
      }

      /* ── MIRROR REFLECTION ── */
      .mirror-reflection {
            position: relative;
            z-index: 20;
            text-align: center;
            padding: 0 24px 20px;
      }
      .reflection-label {
            font-family: "JetBrains Mono", monospace;
            font-size: 9px;
            letter-spacing: 5px;
            color: var(--muted-dark);
            margin-bottom: 32px;
            opacity: 0;
            transform: translateY(16px);
            transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s;
      }
      .reflection-label.vis { opacity: 1; transform: none; }

      .recognition-strip {
            display: flex;
            gap: 0;
            overflow: hidden;
            mask-image: linear-gradient(90deg, transparent, black 15%, black 85%, transparent);
      }
      .recognition-track {
            display: flex;
            gap: 16px;
            animation: stripScroll 22s linear infinite;
            white-space: nowrap;
      }
      @keyframes stripScroll {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
      }
      .recognition-track:hover { animation-play-state: paused; }

      .recog-pill {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 24px;
            border: 1px solid #1e1e1e;
            background: #0c0c0c;
            font-family: "Lora", serif;
            font-size: 13px;
            font-style: italic;
            color: rgba(240, 237, 232, 0.45);
            transition: all 0.3s;
            flex-shrink: 0;
      }
      .recog-pill:hover {
            border-color: rgba(255, 140, 0, 0.3);
            color: rgba(240, 237, 232, 0.85);
            background: #111;
      }
      .recog-pill .dot {
            width: 5px; height: 5px;
            border-radius: 50%;
            background: var(--amber);
            opacity: 0.4;
            flex-shrink: 0;
      }
      .recog-pill:hover .dot { opacity: 1; }

      /* ── SECTION OUTRO ── */
      .mirror-outro {
            position: relative;
            z-index: 20;
            text-align: center;
            padding: 80px 24px 0;
            opacity: 0;
            transform: translateY(30px);
            transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .mirror-outro.vis { opacity: 1; transform: none; }
      .mirror-outro p {
            font-family: "Playfair Display", serif;
            font-size: clamp(18px, 2.5vw, 28px);
            font-style: italic;
            color: rgba(240, 237, 232, 0.35);
            max-width: 640px;
            margin: 0 auto 12px;
            line-height: 1.6;
      }
      .mirror-outro p strong { color: rgba(240, 237, 232, 0.75); font-style: normal; }
      .mirror-outro .next-hint {
            font-family: "JetBrains Mono", monospace;
            font-size: 9px;
            letter-spacing: 5px;
            color: var(--amber);
            margin-top: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            opacity: 0.6;
      }
      .next-hint::before, .next-hint::after {
            content: "";
            width: 40px; height: 1px;
            background: var(--amber);
            opacity: 0.4;
      }

      /* ── COLLAGE FLOATING ELEMENTS ── */
      .mirror-float {
            position: absolute;
            pointer-events: none;
            opacity: 0.04;
            font-family: "Bebas Neue", sans-serif;
            letter-spacing: 10px;
            color: var(--text-light);
            white-space: nowrap;
      }
      .mf-1 { top: 8%; left: -5%; font-size: 120px; transform: rotate(-5deg); }
      .mf-2 { top: 40%; right: -8%; font-size: 90px; transform: rotate(8deg); }
      .mf-3 { bottom: 15%; left: 5%; font-size: 80px; transform: rotate(-3deg); }

      #mirror-wrapper { 
            position: relative; 
            width: 100%; 
            height: max-content;
      }
      #mirror-container {
            width: 300px;
            height: 300px;
            position: relative;
            left: 50%;
            transform-style: preserve-3d;
            transform-origin: center;
            margin-top: 400px;
            animation-name: mirror-animation;
            animation-timing-function: linear;
            animation-duration: 20s;
            animation-iteration-count: infinite;
      }
      #mirror-container > div {
            animation-name: mirror-text-animation;
            animation-duration: 20s;
            animation-timing-function: linear;
            animation-iteration-count: infinite;
      }
      #mirror-container > div > .reflection {
            animation-name: mirror-reflection-animation;
            animation-duration: 20s;
            animation-timing-function: linear;
            animation-iteration-count: infinite;
      }

      @keyframes mirror-animation {
            0% { transform: translateX(-50%) perspective(1200px) rotateY(0); }
            100% { transform: translateX(-50%) perspective(1200px) rotateY(360deg); }
      }
      @keyframes mirror-text-animation {
            0% { filter: blur(0); }
            15% { filter: blur(4px); }
            85% { filter: blur(4px); }
            100% { filter: blur(0); }
      }
      @keyframes mirror-reflection-animation {
            0% { left: 150%; }
            15% { left: 150%; }
            85% { left: 150%; }
            100% { left: -50%; }
      }

      @media (max-width: 900px) {
            .pillars-wrap { grid-template-columns: 1fr; }
            .pillar-card { --tilt: 0deg !important; }
            .doom-grid { grid-template-columns: 1fr; }
            .dc-tall { grid-row: auto; }
            .doom-reckoning-inner { grid-template-columns: 1fr; gap: 40px; }
            .doom-ticker { grid-template-columns: 1fr; text-align: center; padding: 28px 24px; }
            .ticker-divider { width: 40px; height: 1px; margin: 16px auto; background: linear-gradient(to right, transparent, rgba(255,140,0,0.2), transparent); }
      }
      @media (max-width: 600px) {
            .mirror-archetype-wrap { width: 130px; }
            .archetype-text { font-size: 12px; }
      }
</style>

<script src="../scripts/mirror/mirror-pillarcards.ts"></script>