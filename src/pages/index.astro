---
import "../styles/global.css";

import SidebarNavigation from "../components/SidebarNavigation.svelte";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import TheMirror from "../components/TheMirror.astro";
import TheNumbers from "../components/TheNumbers.astro";
import TheQuiz from "../components/TheQuiz.astro";
import TheLifeCycle from "../components/TheLifeCycle.astro";
import TheShift from "../components/TheShift.astro";
import ThePledge from "../components/ThePledge.astro";
import Footer from "../components/Footer.astro";
import TheTruth from "../components/TheTruth.astro";
---

<!doctype html>
<html lang="en">
      <head>
            <meta charset="UTF-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1.0" />
            <title>THE LAST PURCHASE — You Are What You Buy</title>
            <link rel="preconnect" href="https://fonts.googleapis.com" />
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
            <link
                  href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Bebas+Neue&family=Lora:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;700&display=swap"
                  rel="stylesheet"
            />
      </head>
      <body>
            <div id="cur"></div>
            <div id="spb"></div>

            <Navbar />
            <SidebarNavigation />
            <Hero />

            <TheTruth />
            <TheMirror />
            <TheNumbers />
            <TheQuiz />
            <TheLifeCycle />
            <TheShift />
            <ThePledge />
            <Footer />

            <script src="../scripts/global/custom-cursor.ts"></script>
            <script src="../scripts/global/darkmode-each-section.ts"></script>
            <script src="../scripts/global/scroll-progress.ts"></script>
            <script src="../scripts/global/universal-reveal-objects.ts"></script>
            <script src="../scripts/global/3d-card-tilt.ts"></script>
      </body>
</html>
